# Copy this file to .env (same directory as docker-compose.yml) and fill in
# real values. .env is gitignored -- never commit real secrets.

# Postgres connection string used by the backend. The default below matches
# docker-compose.yml's db service and normally doesn't need to change.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinelhub

# Free-tier AbuseIPDB API key, used by backend/app/services/threat_intel.py
# to enrich alerts with IP reputation data (abuse score, country, ISP,
# report count). Get one at https://www.abuseipdb.com/register (free tier
# is enough for this project). If left blank, enrichment is skipped
# gracefully -- everything else still works.
ABUSEIPDB_API_KEY=
